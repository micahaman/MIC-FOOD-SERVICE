# Apache / cPanel configuration for www.miguelitoscorp.com
Options -MultiViews -Indexes
RewriteEngine On

# ---------------------------------------------------------------------------
# Force HTTPS and one canonical address (https://www.miguelitoscorp.com).
# Only applies to the real domain, so local/staging copies are unaffected.
# The X-Forwarded-Proto check avoids a redirect loop if the host terminates
# SSL in front of Apache.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} (^|\.)miguelitoscorp\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.miguelitoscorp.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^miguelitoscorp\.com$ [NC]
RewriteRule ^ https://www.miguelitoscorp.com%{REQUEST_URI} [R=301,L,NE]

# ---------------------------------------------------------------------------
# Keep internal files off the web: dot-folders (.git, .claude, ...) except
# .well-known (used for SSL certificates), dev scripts, and deploy configs.
# ---------------------------------------------------------------------------
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
RewriteRule (^|/)(vercel\.json|package(-lock)?\.json|[^/]+\.(py|md|log|sh|bak|sql))$ - [R=404,L]

# ---------------------------------------------------------------------------
# Clean URLs: /about serves about.html, and /about.html redirects to /about.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+index[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Branded page for missing URLs
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Browsers remember to use HTTPS for a year (subdomains not included, so
  # mail/cPanel subdomains without certificates keep working)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content Security Policy: the only places this site may load code, styles,
  # fonts, data and frames from. Anything else is blocked by the browser.
  #   - Google Tag Manager / Analytics: tracking (after cookie consent)
  #   - Google Fonts: Anton + Figtree
  #   - jsDelivr: export globe libraries, world map data, country flags
  #   - FormSubmit: contact and toll manufacturing inquiries
  #   - Google Maps: facility map on the About page
  # 'unsafe-inline' is needed for the consent + GTM snippets in each page.
  # If something breaks after adding a new service in Tag Manager, add its
  # domain here (or temporarily rename the header to
  # Content-Security-Policy-Report-Only to only log problems).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://*.googletagmanager.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://formsubmit.co https://cdn.jsdelivr.net https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.google.com; frame-src https://*.googletagmanager.com https://www.google.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
