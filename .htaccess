# Apache / cPanel configuration for www.miguelitoscorp.com
Options -MultiViews -Indexes
RewriteEngine On

# ---------------------------------------------------------------------------
# Force HTTPS and one canonical address (https://www.miguelitoscorp.com).
# Only applies to the real domain, so local/staging copies are unaffected.
# The X-Forwarded-Proto check avoids a redirect loop if the host terminates
# SSL in front of Apache.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} (^|\.)miguelitoscorp\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.miguelitoscorp.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^miguelitoscorp\.com$ [NC]
RewriteRule ^ https://www.miguelitoscorp.com%{REQUEST_URI} [R=301,L,NE]

# ---------------------------------------------------------------------------
# Keep internal files off the web: dot-folders (.git, .claude, ...) except
# .well-known (used for SSL certificates), dev scripts, and deploy configs.
# ---------------------------------------------------------------------------
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
RewriteRule (^|/)(vercel\.json|package(-lock)?\.json|[^/]+\.(py|md|log|sh|bak|sql))$ - [R=404,L]

# ---------------------------------------------------------------------------
# Clean URLs: /about serves about.html, and /about.html redirects to /about.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+index[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Branded page for missing URLs
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Browsers remember to use HTTPS for a year (subdomains not included, so
  # mail/cPanel subdomains without certificates keep working)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
